{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "titleEn": {
      "type": "string",
      "required": false
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortDesc": {
      "type": "text",
      "required": true
    },
    "shortDescEn": {
      "type": "text",
      "required": false
    },
    "longDesc": {
      "type": "richtext"
    },
    "longDescEn": {
      "type": "richtext"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "repoUrl": {
      "type": "string"
    },
    "liveUrl": {
      "type": "string"
    },
    "techStack": {
      "type": "component",
      "component": "portfolio.tech-tag",
      "repeatable": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["frontend", "backend", "fullstack", "professional", "academic"],
      "required": true,
      "default": "fullstack"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "enumeration",
      "enum": ["live", "archived", "private"],
      "default": "live",
      "required": true
    }
  }
}
